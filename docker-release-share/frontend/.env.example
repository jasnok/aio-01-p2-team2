# Docker Compose 내부에서는 backend 서비스 이름을 사용합니다.
BACKEND_API_URL=http://backend:8000
FRONTEND_DATA_MODE=api
FRONTEND_CONNECTION_CHECK_ENABLED=true
FRONTEND_REQUEST_TIMEOUT_SECONDS=60
FRONTEND_SSE_ENABLED=true
FRONTEND_SSE_TOTAL_TIMEOUT_SECONDS=180
FRONTEND_PRESENTATION_MODE=false

# 화면의 통합 점검용 주소
TEAM_FRONTEND_URL=http://frontend:8501
TEAM_BACKEND_URL=http://backend:8000
TEAM_MCP_URL=http://mcp-server:8013
TEAM_DATABASE_HOST=postgres
TEAM_DATABASE_PORT=5432
TEAM_DATABASE_USER=legal_user
TEAM_DATABASE_NAME=legal_ai
