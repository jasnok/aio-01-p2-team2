# PostgreSQL 컨테이너를 처음 만들 때 사용할 계정입니다.
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis 컨테이너 비밀번호입니다. backend/.env의 REDIS_URL과 같은 값으로 바꿉니다.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# database-tools 컨테이너가 Compose 네트워크에서 사용하는 주소입니다.
DATABASE_URL=postgresql://legal_user:CHANGE_ME_DB_PASSWORD@postgres:5432/legal_ai
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_VERSION=v1
OPENAI_API_KEY=

LAW_API_BASE_URL=https://www.law.go.kr/DRF
LAW_API_OC=
LAW_API_TIMEOUT_SECONDS=20
