# Legal MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8013
MCP_TRANSPORT=http

# Compose 내부 DB 주소. POSTGRES_PASSWORD는 database/.env와 같은 값으로 바꿉니다.
DATABASE_URL=postgresql://legal_user:CHANGE_ME_DB_PASSWORD@postgres:5432/legal_ai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

RETRIEVAL_TOP_K=3
RETRIEVAL_SCORE_THRESHOLD=0.5
VECTOR_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
RETRIEVAL_FUSION=weighted
RRF_K=60
# Enable only after calibrating on reviewed relevance labels.
RETRIEVAL_FILTER_ENABLED=false
RETRIEVAL_CACHE_TTL_SECONDS=60
RETRIEVAL_DATASET_REVISION=seed-702-v1

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=

LEGAL_API_BASE_URL=
LEGAL_API_KEY=
LEGAL_API_TIMEOUT_SECONDS=15
