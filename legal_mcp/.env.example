# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_TRANSPORT=http

# PostgreSQL + pgvector
# 지혜 PC의 실제 내부 IPv4, 사용자명과 비밀번호로 변경합니다.
DATABASE_URL=postgresql://legal_user:legal_password@127.0.0.1:5434/legal_ai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Retrieval
RETRIEVAL_TOP_K=3
RETRIEVAL_SCORE_THRESHOLD=0.5
VECTOR_WEIGHT=0.7
KEYWORD_WEIGHT=0.3

# Embedding provider - never commit a real key
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=

# External legal-data API (optional)
LEGAL_API_BASE_URL=
LEGAL_API_KEY=
LEGAL_API_TIMEOUT_SECONDS=15

