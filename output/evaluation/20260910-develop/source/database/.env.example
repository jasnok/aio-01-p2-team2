# Docker PostgreSQL + pgvector
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5434

# Used by migration/seed scripts running outside the container
DATABASE_URL=postgresql://legal_user:legal_password@127.0.0.1:5434/legal_ai
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_VERSION=v1
OPENAI_API_KEY=

# 국가법령정보 공동활용
LAW_API_BASE_URL=https://www.law.go.kr/DRF

# 공동활용 신청 후 발급·승인된 OC 값
LAW_API_OC=실제_OC_인증값

# HTTP 요청 제한시간
LAW_API_TIMEOUT_SECONDS=20