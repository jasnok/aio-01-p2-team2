# Optional root environment for running every service on one PC.
# 각자 서버를 나누어 실행할 때는 아래 서비스별 예시를 사용합니다.
# - frontend/.env.example
# - backend/.env.example
# - legal_mcp/.env.example
# - database/.env.example

BACKEND_API_URL=http://127.0.0.1:8000
FRONTEND_REQUEST_TIMEOUT_SECONDS=30

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MCP_SERVER_URL=http://127.0.0.1:8001
REQUEST_TIMEOUT_SECONDS=60
MAX_TOOL_CALLS=3
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0

MCP_HOST=0.0.0.0
MCP_PORT=8001
DATABASE_URL=postgresql://legal_user:change-me@127.0.0.1:5432/legal_ai
RETRIEVAL_TOP_K=3
RETRIEVAL_SCORE_THRESHOLD=0.5

LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
LEGAL_API_BASE_URL=
LEGAL_API_KEY=
