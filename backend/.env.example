# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
REQUEST_TIMEOUT_SECONDS=60
MAX_TOOL_CALLS=3

# Legal MCP server
# 병훈 PC의 실제 내부 IPv4로 변경합니다.
MCP_SERVER_URL=http://127.0.0.1:8001
MCP_REQUEST_TIMEOUT_SECONDS=15

# Short-term conversation context (optional until MUST features are complete)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_MESSAGES=5

# LLM provider - never commit a real key
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# Agent policy
SUPPORTED_CATEGORIES=housing,labor,consumer
RETRIEVAL_TOP_K=3

