# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
REQUEST_TIMEOUT_SECONDS=60
MAX_TOOL_CALLS=3

# Legal MCP server
# 병훈 PC의 실제 내부 IPv4로 변경합니다.
MCP_SERVER_URL=http://192.100.200.72:8011
MCP_REQUEST_TIMEOUT_SECONDS=15

# Streamable HTTP MCP integration smoke test
FOOD_MCP_URL=http://192.100.200.72:8011/mcp
ENABLE_INTEGRATION_DEBUG=false

# Short-term conversation context (optional until MUST features are complete)
REDIS_ENABLED=false
# ! → %21 : url 인코딩해야 안전하여야한다하여 필요시 ! 자리에 작성하면 됩니다.
REDIS_URL=redis://127.0.0.1:6380/0 # redis://:<REDIS_PASSWORD>@127.0.0.1:6380/0
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_MESSAGES=5

# LLM provider - never commit a real key
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# Agent policy
SUPPORTED_CATEGORIES=housing,labor,consumer
RETRIEVAL_TOP_K=3

