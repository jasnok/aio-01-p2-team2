# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
REQUEST_TIMEOUT_SECONDS=60
MAX_TOOL_CALLS=3

# Legal MCP server
# FastMCP Streamable HTTP endpoint. 실제 팀 MCP IP로 변경합니다.
LEGAL_MCP_URL=http://192.100.200.72:8011/mcp
MCP_REQUEST_TIMEOUT_SECONDS=10
# true는 Backend 메모리 Mock, false는 실제 Legal MCP만 사용합니다.
BACKEND_MOCK_MODE=true

# Short-term conversation context (optional until MUST features are complete)
REDIS_ENABLED=false
# ! → %21 : url 인코딩해야 안전하여야한다하여 필요시 ! 자리에 작성하면 됩니다.
REDIS_URL=redis://127.0.0.1:6380/0 # redis://:<REDIS_PASSWORD>@127.0.0.1:6380/0
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_MESSAGES=5

# LLM provider - never commit a real key
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# Agent policy
SUPPORTED_CATEGORIES=housing,labor,consumer
RETRIEVAL_TOP_K=3

