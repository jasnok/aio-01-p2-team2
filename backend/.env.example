# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_MOCK_MODE=false
FRONTEND_ORIGIN=http://localhost:8501
REQUEST_TIMEOUT_SECONDS=60
MCP_REQUEST_TIMEOUT_SECONDS=60
INPUT_ASSESSMENT_TIMEOUT_SECONDS=8
MAX_TOOL_CALLS=3

# Compose 내부 서비스 주소. POSTGRES_PASSWORD는 database/.env와 같은 값으로 바꿉니다.
LEGAL_MCP_URL=http://mcp-server:8013/mcp
DATABASE_URL=postgresql://legal_user:CHANGE_ME_DB_PASSWORD@postgres:5432/legal_ai
REDIS_ENABLED=true
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
AUTH_SESSION_TTL_SECONDS=28800
GUEST_SESSION_TTL_SECONDS=3600
TERM_RUN_TTL_SECONDS=3600
AGENT_RUN_TTL_SECONDS=86400
AGENT_RUN_TIMEOUT_SECONDS=150
CITATION_MODE=spans
# Empty model overrides use OPENAI_MODEL. Verification adds latency and API use.
INTAKE_MODEL=
ANSWER_MODEL=
VERIFICATION_MODEL=
SEMANTIC_VERIFICATION_ENABLED=true
ANSWER_REPAIR_ATTEMPTS=1

# API Key는 Git에 커밋하지 않습니다.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
